# --- Провайдер ИИ (этап 3) ---
# openai | groq | ollama. Пустое значение — автоопределение по ключам ниже.
WORLDSIM_AI_PROVIDER=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# --- Ollama (локальный сервер) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
